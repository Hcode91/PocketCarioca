<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocketCarioca" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FF06231A</item>
        <item name="colorSecondary">@color/accent2</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Theme.PocketCarioca.Settings" parent="Theme.PocketCarioca">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>
    <style name="Theme.PocketCarioca.Game" parent="Theme.PocketCarioca">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
