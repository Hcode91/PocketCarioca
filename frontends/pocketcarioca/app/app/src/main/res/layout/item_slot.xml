<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card" android:padding="6dp">
    <ImageView android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="90dp"
        android:scaleType="fitCenter" android:background="#FF000000" android:contentDescription="@null" />
    <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text" android:textSize="13sp" android:paddingTop="4dp" />
</LinearLayout>
